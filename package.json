{
  "name": "brtwrst",
  "productName": "BRTWRST",
  "version": "0.1.2",
  "description": "Team-Bratwurst-Intranet als App, mit direktem RCON und LAN-Scan für die CS2-Server",
  "homepage": "https://github.com/bauerrrrrrr/brtwrst-app",
  "author": "Team Bratwurst",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "build": {
    "appId": "pw.wurst.brat.brtwrst",
    "productName": "BRTWRST",
    "artifactName": "BRTWRST-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "Team Bratwurst",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "BRTWRST"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "BRTWRST ${version}"
    }
  },
  "devDependencies": {
    "dbus-next": "^0.10.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "desktopName": "brtwrst.desktop"
}
